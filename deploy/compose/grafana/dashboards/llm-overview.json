{
  "uid": "open-llm-infra",
  "title": "Open LLM infra: gateway and backends",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "llm",
    "litellm",
    "vllm",
    "llama.cpp"
  ],
  "panels": [
    {
      "type": "timeseries",
      "title": "Gateway requests / s by model and status",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (requested_model, status_code) (rate(litellm_proxy_total_requests_metric_total[5m]))",
          "legendFormat": "{{requested_model}} {{status_code}}"
        }
      ],
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Gateway end-to-end latency p50 / p95",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, model) (rate(litellm_request_total_latency_metric_bucket[5m])))",
          "legendFormat": "p50 {{model}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, model) (rate(litellm_request_total_latency_metric_bucket[5m])))",
          "legendFormat": "p95 {{model}}"
        }
      ],
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Time to first token p95 (gateway view)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, model) (rate(litellm_llm_api_time_to_first_token_metric_bucket[5m])))",
          "legendFormat": "{{model}}"
        }
      ],
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "Deployment state (0 healthy, 1 partial, 2 cooled down)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (litellm_model_name, api_base) (litellm_deployment_state)",
          "legendFormat": "{{litellm_model_name}} {{api_base}}"
        }
      ],
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "llama.cpp generation tokens / s",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "llamacpp:predicted_tokens_seconds",
          "legendFormat": "{{instance}}"
        },
        {
          "refId": "B",
          "expr": "rate(llamacpp:tokens_predicted_total[1m])",
          "legendFormat": "rate {{instance}}"
        }
      ],
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "llama.cpp queue",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "llamacpp:requests_processing",
          "legendFormat": "processing"
        },
        {
          "refId": "B",
          "expr": "llamacpp:requests_deferred",
          "legendFormat": "deferred"
        }
      ],
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "vLLM requests running / waiting",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model_name) (vllm:num_requests_running)",
          "legendFormat": "running {{model_name}}"
        },
        {
          "refId": "B",
          "expr": "sum by (model_name) (vllm:num_requests_waiting)",
          "legendFormat": "waiting {{model_name}}"
        }
      ],
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "vLLM generation tokens / s and KV cache use",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model_name) (rate(vllm:generation_tokens_total[1m]))",
          "legendFormat": "tok/s {{model_name}}"
        },
        {
          "refId": "B",
          "expr": "max by (model_name) (vllm:kv_cache_usage_perc)",
          "legendFormat": "kv cache {{model_name}}"
        }
      ],
      "id": 8
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}